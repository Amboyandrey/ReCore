ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://recore:recore@localhost:5432/recore
REDIS_URL=redis://localhost:6379/0

# Optional. The role the running API actually serves requests as — left unset, it falls back to
# DATABASE_URL's role above. Set it to a distinct, low-privilege role (see the row-level-security
# migration) and RLS policies become real instead of silently bypassed by the table owner. Docker
# Compose sets this to `recore_app`; local non-Docker dev is fine leaving it unset.
APP_DATABASE_URL=

CORS_ORIGINS=["http://localhost:3000"]

# Base64-encoded 32-byte key used to wrap provider-credential data keys (phase 4). Generate with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MASTER_KEY=

SESSION_COOKIE_NAME=recore_session

# Where uploaded attachments are written.
STORAGE_DIR=./uploads
